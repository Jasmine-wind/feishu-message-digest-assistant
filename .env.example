# 非敏感设置统一放在 assistant.toml；可用该变量指定其他配置文件。
ASSISTANT_CONFIG_FILE=assistant.toml

# 密钥只放在环境变量或部署平台的密钥存储中，不要写入 assistant.toml。
FEISHU_APP_SECRET=
# 消息摘要使用阿里云百炼 qwen3.7-flash；会议功能默认关闭，不需要 ASR_API_KEY。
LLM_API_KEY=

# 仅在显式启用 features.meeting_summary 的开发/兼容场景配置。
# ASR_API_KEY=

# 仅供旧版直连/开发诊断；正式 OAuth 用户无需配置。
FEISHU_USER_ACCESS_TOKEN=

# assistant.toml 中的每项都保留对应环境变量覆盖能力，便于部署平台注入。
